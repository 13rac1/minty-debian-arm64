# System-wide MATE desktop defaults (the Mint-Y-Dark green/dark look);
# users can override per session. The GTK theme, the base Mint-Y metacity
# theme, and the Mint-Y icons come from mint-themes/mint-y-icons; the
# cursor from bibata-cursor-theme. The base Mint-Y metacity theme is
# adaptive — it pulls wm_* colors (gtk:custom) from the active GTK theme —
# so a single WM theme renders this variant's green/dark window borders.
#
# DANGER: the dconf paths differ from the gsettings schema ids — group
# headers are the paths. org.mate.interface lives at .../desktop/interface;
# org.mate.Marco.general lives at .../marco/general (lowercase). A wrong
# header is silently ignored.

[org/mate/desktop/interface]
gtk-theme='Mint-Y-Dark'
icon-theme='Mint-Y'

[org/mate/marco/general]
theme='Mint-Y'

[org/mate/desktop/peripherals/mouse]
cursor-theme='Bibata-Modern-Classic'
cursor-size=24

# Single bottom panel instead of the default two (top + bottom). Selects
# the baked minty.layout; a fresh user's mate-panel instantiates it on
# first run. SEE mate-panel/minty.layout.
[org/mate/panel/general]
default-layout='minty'

# Pluma (the text editor) colors its edit area from a GtkSourceView scheme,
# not the GTK theme; Debian's default 'tango' is light, so under the dark
# theme the current-line highlight renders light-on-light. Use a dark scheme.
[org/mate/pluma]
color-scheme='oblivion'

# Fallback for GTK/GNOME apps that read the gnome schema (portals, GTK4).
[org/gnome/desktop/interface]
gtk-theme='Mint-Y-Dark'
icon-theme='Mint-Y'
color-scheme='prefer-dark'
