# System-wide MATE desktop defaults (the "DarkShiny" look); users can
# override per session. Every component ships in Debian, so nothing is
# baked into the image: Adwaita-dark from gnome-themes-extra-data, the
# Shiny Marco theme and the mate cursor from mate-themes, mate icons from
# mate-icon-theme.
#
# DANGER: the dconf paths differ from the gsettings schema ids — group
# headers are the paths. org.mate.interface lives at .../desktop/interface;
# org.mate.Marco.general lives at .../marco/general (lowercase). A wrong
# header is silently ignored.

[org/mate/desktop/interface]
gtk-theme='Adwaita-dark'
icon-theme='mate'
gtk-color-scheme='tooltip_fg_color:#ffffff,tooltip_bg_color:#343434'

[org/mate/marco/general]
theme='Shiny'

[org/mate/desktop/peripherals/mouse]
cursor-theme='mate'
cursor-size=24

# Fallback for GTK/GNOME apps that read the gnome schema (portals, GTK4).
[org/gnome/desktop/interface]
gtk-theme='Adwaita-dark'
icon-theme='mate'
color-scheme='prefer-dark'
